{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "prize_id": {
      "type": "string"
    },
    "prize_name": {
      "type": "string"
    },
    "prize_name_hi": {
      "type": "string"
    },
    "spin_id": {
      "type": "string"
    },
    "discount_value": {
      "type": "string"
    },
    "discount_value_hi": {
      "type": "string"
    },
    "claimed": {
      "type": "boolean",
      "default": false
    },
    "claimed_date": {
      "type": "string",
      "format": "date-time"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "code",
    "customer_id",
    "prize_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}