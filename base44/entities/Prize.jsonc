{
  "name": "Prize",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "name_hi": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_hi": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "discount_value": {
      "type": "string"
    },
    "discount_value_hi": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "default": 0
    },
    "inventory": {
      "type": "number",
      "default": 0
    },
    "initial_inventory": {
      "type": "number",
      "default": 0
    },
    "expiration_days": {
      "type": "number",
      "default": 30
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "is_try_again": {
      "type": "boolean",
      "default": false
    }
