{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "phone_raw": {
      "type": "string"
    },
    "phone_normalized": {
      "type": "string"
    },
    "spins_in_cycle": {
      "type": "number",
      "default": 0
    },
    "total_spins": {
      "type": "number",
      "default": 0
    },
    "cycle_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_spin_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "phone_normalized"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}